# 复制为 .env 后按需修改；带 * 的为必填项
# PostgreSQL 连接串
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chishafan?schema=public

# * 会话密钥，至少 32 字符（AUTH-06），生产环境务必替换为随机值
NUXT_APP_SECRET=please-change-me-to-a-32-char-random-string

# LLM（OpenAI 兼容 chat/completions 协议，可选；三项要么全配要么不配）
# 例：智谱 GLM
NUXT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
NUXT_LLM_MODEL=glm-4-flash
NUXT_LLM_API_KEY=

# 知识库向量化（可选；三项要么全配要么不配）
# 复用智谱 embedding-3，维度必须与迁移里的 vector(1024) 一致；
# 未配置时问答自动降级为关键词检索，功能可用但语义匹配变差。
NUXT_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
NUXT_EMBEDDING_MODEL=embedding-3
NUXT_EMBEDDING_API_KEY=
# NUXT_EMBEDDING_DIMENSIONS=1024
# 检索相似度阈值（0~1，默认 0.35）：越高越保守，越容易拒答
# NUXT_RAG_THRESHOLD=0.35

# 邮件（Resend，可选；找回密码 / 邮箱换绑需要）
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=吃啥饭 <no-reply@example.com>
NUXT_APP_URL=http://localhost:3000

# 可选：AI 每日配额与历史去重默认天数
# NUXT_AI_DAILY_QUOTA_USER=30
# NUXT_AI_DAILY_QUOTA_GUEST=5
# Token 额度（按天累计，DB 记账；与上面的次数配额是两套口径）
# 不配置时使用代码默认值：登录用户 50000，游客 20000（见 server/utils/quotaMath.ts）
# NUXT_AI_DAILY_TOKEN_USER=50000
# NUXT_AI_DAILY_TOKEN_GUEST=20000
# HISTORY_DAYS=3

# 可选：开发环境模拟定位城市（免去真实 IP 定位）
# AMBIENT_DEV_CITY=上海

# 可选：菜品图上传目录（默认 .data/uploads，已在 .gitignore 内）
# Docker 部署由 docker-compose.yml 指到 uploads 卷，不要在这里覆盖成容器内临时路径
# UPLOAD_DIR=.data/uploads
