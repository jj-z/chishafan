// 用户口味偏好：一对一挂在 User 下，供随机推荐与后续 AI 推荐共用。
//
// 为什么单独建表而不是塞进 User：
// 1. 偏好字段较多且会持续演进，塞进 User 会让登录查询也背上这些列；
// 2. 偏好是可选数据（用户没设置就没有记录），独立表可以用「有无记录」区分默认值；
// 3. 后续 AI 推荐需要一次性读取完整偏好，单独 select 更清晰。

model UserPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 喜欢 / 不喜欢的菜系（Category.id）。喜欢加权，不喜欢降权，都不做硬排除（PREF-01）。
  likedCategoryIds    String[] @default([])
  dislikedCategoryIds String[] @default([])

  // 忌口 / 过敏原：硬过滤，命中即不参与推荐（PREF-02）。禁止为了凑结果放宽。
  allergens Allergen[] @default([])

  // 辣度上限 0-3、价格上限 1-3。辣度是硬约束，价格只做软降权（PREF-03/04）。
  spicyMax Int @default(3)
  priceMax Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}
